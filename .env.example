# Copy this file to .env.local (local dev) and add the same variable in Vercel's
# Project Settings → Environment Variables for production. Never commit .env.local.

# From Supabase: Project Settings → Database → Connection string → "URI" (use the
# pooled "Transaction" connection string for serverless hosts like Vercel).
DATABASE_URL=

# The site's primary public URL (https, no trailing slash). Every canonical
# tag, sitemap URL, structured-data URL and Open Graph URL is built from it.
# Leave unset for local dev; set to https://flatfolks.in in production, and make
# the host redirect www.flatfolks.in to it (not the other way round).
NEXT_PUBLIC_SITE_URL=

# Credentials for the /admin workspace (see /admin/login). Pick your own values —
# never commit real ones. Required for /admin to be reachable at all.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional second step for /admin/login: a 6-digit code from an authenticator
# app. Make one with `node scripts/admin-totp.mjs` and scan the link it prints.
ADMIN_TOTP_SECRET=

# Signs sign-in cookies (and, with ADMIN_PASSWORD, admin sessions). Required in
# production: a long random value, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it sessions fall back to ADMIN_PASSWORD, which a user could guess
# offline from their own cookie. Changing it signs everyone out.
SESSION_SECRET=

# Supabase Storage, used to hold uploaded listing photos (free tier: 1GB).
# From Supabase: Project Settings → Data API → Project URL, and
# Project Settings → API Keys → service_role secret key (NOT the anon/public key —
# this one bypasses Row Level Security, so it must stay server-side only).
# Create a public bucket with this exact name before uploading (Storage → New bucket).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=listing-photos

# Resend, used to actually email login/signup OTP codes (free tier: 100/day,
# 3000/month). Without this set, OTPs fall back to being shown on-screen —
# fine for local dev, not for real users. Get RESEND_API_KEY from
# resend.com/api-keys. RESEND_FROM_EMAIL requires a verified domain in Resend
# (Domains → Add Domain) before it can email real recipients — until then,
# leave it unset to use Resend's shared test address, which only delivers to
# your own Resend account email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Sender of the one-time welcome email for new accounts. Leave unset to use
# hello@ on RESEND_FROM_EMAIL's domain (e.g. FlatFolks <hello@flatfolks.in>).
RESEND_WELCOME_FROM_EMAIL=

# Inactive-owner post removal (src/lib/inactive-posts.ts), run daily by the
# Vercel Cron in vercel.json. Vercel sends CRON_SECRET as a Bearer token.
# RESTORE_TOKEN_SECRET signs the "Restore my post" email links. Use long random
# values, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
CRON_SECRET=
RESTORE_TOKEN_SECRET=
# Set to "true" to email owners 5 days before their posts would be removed.
# Inactive-owner post removal (daily cron) is paused unless this is "true".
INACTIVE_POSTS_ENABLED=false
INACTIVITY_WARNING_EMAILS=false
