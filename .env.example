# Copy this file to .env.local (local dev) and add the same variable in Vercel's
# Project Settings → Environment Variables for production. Never commit .env.local.

# From Supabase: Project Settings → Database → Connection string → "URI" (use the
# pooled "Transaction" connection string for serverless hosts like Vercel).
DATABASE_URL=

# Credentials for the /admin workspace (see /admin/login). Pick your own values —
# never commit real ones. Required for /admin to be reachable at all.
ADMIN_USERNAME=
ADMIN_PASSWORD=
